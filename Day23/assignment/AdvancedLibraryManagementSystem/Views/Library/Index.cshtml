@model AdvancedLibraryManagementSystem.ViewModels.LibraryDashboardVm

@{
    ViewData["Title"] = "Library Dashboard";
}

<div class="row g-3">
    <div class="col-12">
        <h2>Advanced Library Management</h2>
        <p class="text-muted mb-0">Async CRUD with Repository Pattern, EF Core, and AJAX.</p>
    </div>

    <div class="col-lg-3">
        <div class="card">
            <div class="card-header">Filters</div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label">Search</label>
                    <input type="text" id="searchInput" class="form-control" placeholder="Title / Author" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Author</label>
                    <select id="authorFilter" class="form-select">
                        <option value="">All</option>
                        @foreach (var author in Model.Authors)
                        {
                            <option value="@author.Id">@author.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Genre</label>
                    <select id="genreFilter" class="form-select">
                        <option value="">All</option>
                        @foreach (var genre in Model.Genres)
                        {
                            <option value="@genre.Id">@genre.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Sort</label>
                    <select id="sortBy" class="form-select">
                        <option value="title_asc">Title (A-Z)</option>
                        <option value="title_desc">Title (Z-A)</option>
                        <option value="year_asc">Year (Asc)</option>
                        <option value="year_desc">Year (Desc)</option>
                    </select>
                </div>
                <button id="applyFiltersBtn" class="btn btn-primary w-100">Apply</button>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="d-flex justify-content-between mb-2">
            <h5>Books</h5>
            <button id="newBookBtn" class="btn btn-success btn-sm">Add Book</button>
        </div>
        <div id="messageBox"></div>
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Year</th>
                    <th>Genres</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="booksTbody"></tbody>
        </table>
        <div class="d-flex justify-content-between align-items-center">
            <span id="pageInfo"></span>
            <div>
                <button id="prevBtn" class="btn btn-outline-secondary btn-sm">Prev</button>
                <button id="nextBtn" class="btn btn-outline-secondary btn-sm">Next</button>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Authors</div>
            <div class="card-body">
                <div class="input-group mb-2">
                    <input id="authorNameInput" class="form-control" placeholder="Author name" />
                    <button id="addAuthorBtn" class="btn btn-outline-primary">Add</button>
                </div>
                <ul id="authorsList" class="list-group"></ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Genres</div>
            <div class="card-body">
                <div class="input-group mb-2">
                    <input id="genreNameInput" class="form-control" placeholder="Genre name" />
                    <button id="addGenreBtn" class="btn btn-outline-primary">Add</button>
                </div>
                <ul id="genresList" class="list-group"></ul>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bookModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Book</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="bookId" />
                <div class="mb-2">
                    <label class="form-label">Title</label>
                    <input id="titleInput" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">ISBN</label>
                    <input id="isbnInput" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Published Year</label>
                    <input id="yearInput" type="number" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Author</label>
                    <select id="authorInput" class="form-select">
                        @foreach (var author in Model.Authors)
                        {
                            <option value="@author.Id">@author.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Genres (Ctrl+Click multi-select)</label>
                    <select id="genreInput" class="form-select" multiple>
                        @foreach (var genre in Model.Genres)
                        {
                            <option value="@genre.Id">@genre.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button id="saveBookBtn" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.librarySeed = {
            authors: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Authors.Select(a => new { a.Id, a.Name }))),
            genres: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Genres.Select(g => new { g.Id, g.Name })))
        };
    </script>
    <script src="~/js/library.js" asp-append-version="true"></script>
}
