@model WebApplication1.Models.SurveyModel

@{
    Layout = null;
}


<div class="container">


    <h1>Survey Form</h1> 
    <h2> We will take your name and your message so other participants can see your message. </h2> 




    <form method="post">
        <label for="Name">Name:</label> 
        <input asp-for="Name"> <br />

        <label for="Message">Message:</label>
        <textarea asp-for="Message"></textarea> <br />

        <button type="submit">Submit</button>
    </form>


    @if(ViewBag.Message!=null)
    {
        @ViewBag.Message
    }
    <h2>See all messages: 
        <a asp-controller="Survey" asp-action="AllMessages">Look</a>
    </h2>
</div>





<style>

    body {
        margin: 0;
        font-family: 'Segoe UI';
        background: linear-gradient(to bottom left, #d8ccc8, #efe7e4);
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .container {
        width: 420px;
        background: rgba(255,255,255,0.75);
        backdrop-filter: blur(10px);
        padding: 35px;
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    h1 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 38px;
        color: #4e342e;
    }

    h2 {
        font-size: 15px;
        font-weight: 400;
        line-height: 1.6;
        color: #6d4c41;
        margin-bottom: 30px;
    }

    label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #4e342e;
    }

    input,
    textarea {
        width: 100%;
        padding: 14px;
        margin-bottom: 22px;
        border: 1px solid #d7ccc8;
        border-radius: 14px;
        font-size: 15px;
        box-sizing: border-box;
        outline: none;
        transition: 0.3s;
    }

        input:focus,
        textarea:focus {
            border-color: #8d6e63;
            box-shadow: 0 0 0 4px rgba(141,110,99,0.15);
        }

    textarea {
        height: 130px;
        resize: none;
    }

    button {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 14px;
        background: #6d4c41;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
    }

        button:hover {
            background: #4e342e;
            transform: translateY(-2px);
        }

    .success {
        margin-top: 20px;
        text-align: center;
        color: #2e7d32;
        font-weight: 600;
    }

</style>


